          "5E8324F498F95B1A721C7F30CE6DCAC5"
        ]
      }
    },
    "bw-chimes": {
      "title": "The Wayside Chimes",
      "text": "The road to the Shrine of Waking climbs through the Blossomwood, where three wayside chimes stand frozen in the snow.",
      "stages": [
        {
          "id": "guide",
          "text": "Corin Ashby knows the wood. The chimes come first, he says — the shrine gate has not opened since the frost."
        },
        {
          "id": "order",
          "text": "The three chimes ring the first notes of Mam's song. Strike them in its order: Wake, Turn, Gold."
        },
        {
          "id": "gate",
          "text": "The shrine gate is open. Something waits in the glade beneath the Bell of Waking."
        }
      ],
      "textKeys": {
        "text": "711552E98201E05A84B73813073677A0",
        "stages": {
          "guide": "B16E332170ED6A8300B6DBE5EA913CBA",
          "order": "DFD121A62F2D508DAA15AEFAADC11730",
          "gate": "713CF53905864BD5CFAC4B1A1B1B345A"
        }
      }
    },
    "sc-ledger": {
      "title": "Wenna's Ledger",
      "text": "Saltcombe's harbour master keeps a tally of what the frost has cost her harbour. She means to collect.",
      "stages": [
        {
          "id": "lamps",
          "text": "Two thousand five hundred and fifty-seven lamps, one a night, for a brother's boat. Wenna has joined us — and taken her office door."
        },
        {
          "id": "kraken",
          "text": "One kraken, removed. Paid: no. The lighthouse is up the cliff stair."
        },
        {
          "id": "home",
          "text": "The Patience is home, and Jory with her, seven years late and not a day older. Wenna has an invoice for whoever stopped the year."
        }
      ],
      "textKeys": {
        "text": "07A4EE3EEB60D4F746547516ACD06F4B",
        "stages": {
          "lamps": "B6CF6999294FB8A61FD60DDA96D2AC22",
          "kraken": "BADFAAC259ADCB428DC70B74616F86FF",
          "home": "6973C4651E6115917B8C8C277302EE73"
        }
      }
    },
    "af-harvest": {
      "title": "The Stopped Mills",
      "text": "Amberfield's harvest stands frozen in the fields. Its abbey holds the Bell of Harvest.",
      "stages": [
        {
          "id": "mills",
          "text": "Brother Fallow's lesson: the cantors ring and the knights mend. Silence the ringers first. The mills' fog closes the lane to the abbey."
        },
        {
          "id": "bell",
          "text": "The coat was Grandda's. The drawing was mine. The Bell of Harvest waits at the abbey."
        }
      ],
      "textKeys": {
        "text": "2BF33C690D6A60A3CDFB3169E2FF088B",
        "stages": {
          "mills": "F68ACB2367A80AEAB158B3D784779064",
          "bell": "2ECC9E6AC5FF1E544B7DBC0F59FD19E6"
        }
      }
    }
  },
