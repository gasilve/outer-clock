  "items": {
    "blossom": {
      "name": "Cherry Blossom",
      "text": "A sprig of the Blossomwood's first blossom in seven years. Dilly has never seen one.",
      "key": true,
      "textKeys": {
        "text": "609AD190C780A081FF5558A9B4B43630"
      }
    },
    "receipt": {
      "name": "Wenna's Receipt",
      "text": "In a neat harbour hand: \"One kraken, removed. Paid: no.\" Signed, M. Gale, Harbour Master.",
      "key": true,
      "textKeys": {
        "text": "8E3D923EC94E733A88FB6B5074F41C34"
      }
    },
    "seashell": {
      "name": "Seashell",
      "text": "A spiral shell the first tide in seven years brought to Saltcombe's quay. Dilly has never heard the sea in one.",
      "key": true,
      "textKeys": {
        "text": "F8CCE1D4465146A3E0F3C0605F1BCD2A"
      }
    },
    "osmund-coat": {
      "name": "Grandda's Coat",
      "text": "Osmund Halloway's old work coat, taken off the Harvest Mawkin. Bell-metal burns on both cuffs.",
      "key": true,
      "textKeys": {
        "text": "E98ECCF8CC3D6FA70FB7C2F849A7008A"
      }
    },
    "drawing": {
      "name": "A Child's Drawing",
      "text": "Four bells in a row and a fifth, coloured in black. Underneath, in a child's letters: SO MAM CAN STAY.",
      "key": true,
      "textKeys": {
        "text": "E64B939984B18583F629BC387A01B1EA"
      }
    },
    "red-leaf": {
      "name": "Red Leaf",
      "text": "A maple leaf from Amberfield, red as a forge. Dilly has never seen one fall.",
      "key": true,
      "textKeys": {
        "text": "A66E6B8AA98E46539EC217B4E302E7D4"
      }
    },
    "fork": {
      "name": "Grandda's Tuning Fork",
      "text": "Osmund Halloway's tuning fork. It gives one note, low and long. The Bellkeeper's.",
      "key": true,
      "textKeys": {
        "text": "8CFBAC24A255D3E73B10D39969C6EA92"
      }
    }
  },
  "quests": {
    "year": {
      "title": "The Year That Stopped",
      "text": "Seven winters ago the bells of the valley fell silent and the year stopped turning. Four Season Bells stand at its edges — Waking, Tides, Harvest, Rest — and they have to ring in that order. Grandda's hammer will have to do.",
      "stages": [
        {
          "id": "waking",
          "text": "The Bell of Waking hangs in the shrine on the hill of the Blossomwood, west along the road from Bell Street. Spring is waiting under the snow there."
        },
        {
          "id": "tides",
          "text": "The Bell of Tides is in the lighthouse at Saltcombe, south down the gorge road. The town dug the drift out the day the west bell rang."
        },
        {
          "id": "harvest",
          "text": "The Bell of Harvest hangs in the abbey belfry at Amberfield. The road leaves from the east shore, across the frozen lake."
        },
        {
          "id": "rest",
          "text": "The Bell of Rest waits at Rimeholt, at the head of the valley, past the Frost Gate. So does Grandda."
        },
        {
          "id": "day-one",
          "text": "The year has turned, and spring has come to Evermere. Grandda has gone to sit with Mam in the churchyard."
        },
        {
          "id": "bellkeeper",
          "text": "Grandda is waiting at the square's bell."
        }
      ],
      "goals": [
        {
          "text": "The Bell of Waking",
          "done": "bell-waking"
        },
        {
          "text": "The Bell of Tides",
          "done": "bell-tides"
        },
        {
          "text": "The Bell of Harvest",
          "done": "bell-harvest"
        },
        {
          "text": "The Bell of Rest",
          "done": "bell-rest"
        }
      ],
      "textKeys": {
        "text": "6CF9D02AF9FAD8B094F9D9EC85959A42",
        "stages": {
          "waking": "039FD556D6244F582F2E1D92A25BA5CB",
          "tides": "172E878CF16AE475EC47DC927E57E0DA",
          "harvest": "3B0068974203C509A0DEA6766732C751",
          "rest": "304B7084D9F93D8A334737D9F7F9C373",
          "day-one": "C82BC35FF4CF17162EA69BE759787420",
          "bellkeeper": "CF2770A5D6429679A2E2041A08A6DD4F"
        },
        "goals": [
          "9BC3BF38BD80F3B93FCF7C1338E0AD6F",
          "6DDEFF6713A87D214FEE2600B2FCA14F",
          "863689DAE37C2D39A923DA2A933F16F4",
          "32DDFC2EC0997564A819A5E478568A20"
        ]
      }
    },
    "dilly": {
      "title": "Something for Dilly",
      "text": "Dilly is seven. She has never seen a season. She wants something from each edge of the valley.",
      "stages": [
        {
          "id": "blossom",
          "text": "A flower from the Blossomwood. A real one."
        },
        {
          "id": "shell",
          "text": "A seashell from Saltcombe, from the sea."
        },
        {
          "id": "leaf",
          "text": "A red leaf from Amberfield."
        },
        {
          "id": "crown",
          "text": "A crown of everything, when spring comes to Evermere."
        }
      ],
      "goals": [
        {
          "text": "A blossom",
          "done": "stage:dilly >= shell"
        },
        {
          "text": "A seashell",
          "done": "stage:dilly >= leaf"
        },
        {
          "text": "A red leaf",
          "done": "stage:dilly >= crown"
        }
      ],
      "textKeys": {
        "text": "932B90DF47D1C4151A3EE116D54E4FDE",
        "stages": {
          "blossom": "E958F3371E9FBB0A490214C5F5FECD01",
          "shell": "23941854A3C4DD17F5C50D492ABC75D1",
          "leaf": "31EB4CC39944BA88758CA7B241863214",
          "crown": "517A24795F30D4778EBE14FEFFF22C35"
        },
        "goals": [
          "83F24B8DDE55326B7F44CEBDA36447D7",
